; Engine configuration file.
; Civilizazione — a Civilization VI-depth 4X strategy game.

config_version=5

[application]

config/name="Civilizazione"
config/description="A Civilization VI-depth 4X turn-based strategy game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
RNGService="*res://core/rng_service.gd"
ContentDB="*res://core/content_db.gd"
Game="*res://core/game.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]

; Compatibility, not Forward+.
;
; Godot defaults to Forward+, which needs Vulkan — and the headless box these
; screenshots are rendered on has no Vulkan driver, so every screenshot was
; taken under Compatibility while the shipped build ran Forward+. Lighting looks
; different under the two, which meant the frames used to check the look were
; not showing the game. A stylised low-poly 4X gains little from Forward+ and
; runs far wider without it, so the renderer that can be verified is the one
; that ships.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=2
